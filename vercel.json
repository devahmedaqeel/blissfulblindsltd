{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "routes": [
    {
      "src": "/api/notify",
      "dest": "/api/notify.js"
    },
    {
      "src": "/api/config",
      "dest": "/api/config.js"
    },
    {
      "src": "/api/health$",
      "dest": "/api/index.js"
    },
    {
      "src": "/blinds-peterborough\\.html$",
      "status": 301,
      "headers": { "Location": "/blinds-peterborough/" }
    },
    {
      "src": "/roller-blinds\\.html$",
      "status": 301,
      "headers": { "Location": "/roller-blinds/" }
    },
    {
      "src": "/vertical-blinds\\.html$",
      "status": 301,
      "headers": { "Location": "/vertical-blinds/" }
    },
    {
      "src": "/venetian-blinds\\.html$",
      "status": 301,
      "headers": { "Location": "/venetian-blinds/" }
    },
    {
      "src": "/roman-blinds\\.html$",
      "status": 301,
      "headers": { "Location": "/roman-blinds/" }
    },
    {
      "src": "/wooden-blinds\\.html$",
      "status": 301,
      "headers": { "Location": "/wooden-blinds/" }
    },
    {
      "src": "/blackout-blinds\\.html$",
      "status": 301,
      "headers": { "Location": "/blackout-blinds/" }
    },
    {
      "src": "/made-to-measure-blinds\\.html$",
      "status": 301,
      "headers": { "Location": "/made-to-measure-blinds/" }
    },
    {
      "src": "/contact\\.html$",
      "status": 301,
      "headers": { "Location": "/contact/" }
    },
    {
      "src": "/about\\.html$",
      "status": 301,
      "headers": { "Location": "/about/" }
    },
    {
      "src": "/curtains(/.*)?$",
      "status": 301,
      "headers": { "Location": "/" }
    },
    {
      "src": "/blinds-accessories(/.*)?$",
      "status": 301,
      "headers": { "Location": "/" }
    },
    {
      "src": "/images/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(.*)\\.(css|js)$",
      "headers": { "Cache-Control": "public, max-age=3600, must-revalidate" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://mt1.google.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
      },
      "dest": "/$1"
    }
  ]
}
